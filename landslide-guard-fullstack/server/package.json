{
  "name": "landslide-guard-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Node.js + Express API for Landslide Guard. Handles auth, zones, sensors, field/citizen reports, alerts and response-priority, and proxies AI risk prediction requests to the Python FastAPI ML service.",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/utils/seed.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lowdb": "^7.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  }
}
